// Prisma schema for the template enterprise backend.
// Kept models: User, AuditLog, SystemSetting, RegistrationToken.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
  engineType   = "library"
}

// Connection URL lives in prisma.config.ts (Prisma 7+ requirement).
datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum AuditActor {
  SYSTEM
  USER
  ADMIN
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  passwordHash  String?
  name      String?
  role      UserRole   @default(USER)
  // Backward-compat: the user's single "primary" model id.
  defaultLlmModelId String?
  // Model ENTITLEMENT copied from the redeemed registration token.
  grantedModelIds String[] @default([])
  // Chat-quota RESET EPOCH.
  quotaResetAt DateTime?
  auditLogs AuditLog[] @relation("AuditActor")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tokensCreated  RegistrationToken[] @relation("CreatedTokens")
  tokensConsumed RegistrationToken[] @relation("ConsumedTokens")
  passwordResetTokens PasswordResetToken[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id           String     @id @default(cuid())
  firmId       String?
  actor        AuditActor
  actorUserId  String?
  actorUser    User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action       String
  payloadJson  Json
  createdAt    DateTime   @default(now())

  @@index([actorUserId])
  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// System settings (runtime override of service credentials)
// ─────────────────────────────────────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Registration tokens (one-time admin-issued invite codes for signup)
// ─────────────────────────────────────────────────────────────────────────────

model RegistrationToken {
  token        String    @id
  createdAt    DateTime  @default(now())
  createdById  String?
  createdBy    User?     @relation("CreatedTokens",  fields: [createdById],  references: [id], onDelete: SetNull)
  consumed     Boolean   @default(false)
  consumedAt   DateTime?
  consumedById String?
  consumedBy   User?     @relation("ConsumedTokens", fields: [consumedById], references: [id], onDelete: SetNull)
  firmId       String?
  role         String?
  expiresAt    DateTime?
  grantedModelIds String[] @default([])

  @@index([consumed])
}

// ─────────────────────────────────────────────────────────────────────────────
// Password reset tokens (single-use, short-lived, per OWASP guidance)
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumed   Boolean   @default(false)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Colossus managed accounts (seeded from COLOSSUS_ACCOUNTS_JSON)
// ─────────────────────────────────────────────────────────────────────────────

model ColossusAccount {
  id           String   @id @default(cuid())
  role         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  loginPath    String?  @map("login_path")
  createdBy    String   @default("colossus") @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("colossus_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// Story: shared-channel — vendor ↔ customer shared communication channels.
// Owns Customer and Message. User ids are stored as plain strings so the auth
// tables are never altered.
// ─────────────────────────────────────────────────────────────────────────────

enum SharedChannelRole {
  VENDOR
  CUSTOMER
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String
  name      String?
  createdAt DateTime @default(now())
}

model SharedChannel {
  id          String                @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime              @default(now())
  members     SharedChannelMember[]
  messages    Message[]

  @@index([createdById])
}

model SharedChannelMember {
  id        String            @id @default(cuid())
  channelId String
  channel   SharedChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  email     String
  role      SharedChannelRole
  createdAt DateTime          @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id          String        @id @default(cuid())
  channelId   String
  channel     SharedChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  authorEmail String
  body        String
  createdAt   DateTime      @default(now())

  @@index([channelId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Vendor onboarding (Story: vendor-onboarding)
// userId is a plain reference (no relation) so the auth User model stays untouched.
// ─────────────────────────────────────────────────────────────────────────────

enum VendorDocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model VendorProfile {
  id           String           @id @default(cuid())
  userId       String           @unique
  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?
  address      String?
  documents    VendorDocument[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model VendorDocument {
  id              String               @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile        @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  documentType    String
  fileName        String
  contentType     String?
  sizeBytes       Int
  storageKey      String
  status          VendorDocumentStatus @default(PENDING_REVIEW)
  createdAt       DateTime             @default(now())

  @@index([vendorProfileId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer invite (Story: customer-invite)
// token mirrors a RegistrationToken.token; invitedById is a plain reference so
// the auth tables stay untouched.
// ─────────────────────────────────────────────────────────────────────────────

model CustomerInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  invitedById String
  status      String    @default("PENDING")
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}
